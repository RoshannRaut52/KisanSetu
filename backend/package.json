{
  "name": "kisansetu-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/server": "^11.6.0",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "nanoid": "^5.1.5",
    "pg": "^8.23.0",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.1",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  }
}
